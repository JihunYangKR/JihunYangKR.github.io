---
layout: null
---

<?xml version="1.0" encoding="UTF-8"?>

<urlset
    xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
>

    <!-- Home -->

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}/
        </loc>

    </url>


    <!-- Archive -->

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}/archive/
        </loc>

    </url>


    <!-- Archive Topic Pages -->

    {% assign archive_projects = site.projects
        | where: "archive", true %}

    {% for project in archive_projects %}

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}/archive/{{ project.slug }}/
        </loc>

    </url>

    {% endfor %}


    <!-- Tags -->

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}/archive/tags/
        </loc>

    </url>


    <!-- Years -->

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}/archive/years/
        </loc>

    </url>


    <!-- Projects -->

    {% for project in site.projects %}

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}{{ project.url }}
        </loc>

    </url>

    {% endfor %}


    <!-- Posts -->

    {% for post in site.posts %}

    <url>

        <loc>
            {{ site.url }}{{ site.baseurl }}{{ post.url }}
        </loc>

        <lastmod>
            {{ post.date | date_to_xmlschema }}
        </lastmod>

    </url>

    {% endfor %}

</urlset>
